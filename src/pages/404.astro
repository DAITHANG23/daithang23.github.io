---
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/constants";
import Layout from "@/layouts/Layout.astro";
import NotFoundImage from "@/components/404-image.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`} description="This is not found page.">
  <div class="my-14 flex flex-col items-center justify-center text-center">
    <h1 class="text-primary text-9xl font-bold">Sorry, page not found!</h1>

    <p class="mt-4 text-base">Sorry, we couldn’t find the page you’re looking for.</p>
    <p class="mt-4 text-base">Perhaps you’ve mistyped the URL? Be sure to check your spelling.</p>
    <NotFoundImage />
    <LinkButton href="/" class="my-6 rounded-md bg-black px-4 py-2 text-lg text-white">
      Go back home
    </LinkButton>
  </div>
</Layout>

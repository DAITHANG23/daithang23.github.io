---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import { render } from "astro:content";
import IconChevronLeft from "@/assets/IconChevronLeft.svg";
import IconChevronRight from "@/assets/IconChevronRight.svg";
import BackButton from "@/components/BackButton.astro";
import getPath from "@/utils/getPath";
import ShareLinks from "@/components/ShareLinks.astro";
import PostComments from "@/components/PostComments.astro";

// type Props = CollectionEntry<'blog'>['data'];

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const { title, description, heroImage, tags } = post.data;
const { Content } = await render(post);

/* ========== Prev/Next Posts ========== */
const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost = currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;
---

<Layout title={`${title} | Domcoding`} description={description}>
  <BackButton />
  <div class="mb-10 w-full p-4">
    <div class="relative mb-8 h-[480px] w-full">
      <img
        src={typeof heroImage === "string" ? heroImage : heroImage?.src}
        alt={title}
        class="h-full w-full rounded-lg object-cover md:!my-8"
      />
      <h5 class="absolute top-0 left-0 p-4 text-white">
        {title}
      </h5>
    </div>

    <div class="w-full py-4">
      <Content />
    </div>
    <div class="border-primary border-t border-b border-dashed py-6 text-start">
      {
        tags.map(t => (
          <a
            class="bg-primary inline-flex h-[32px] items-center justify-center rounded-[10px] px-3 text-[13px] font-semibold text-white transition-transform duration-300 hover:-translate-y-1"
            href={`/tags/${t}`}
          >
            {t}
          </a>
        ))
      }
      <ShareLinks />
    </div>

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid w-full grid-cols-1 gap-6 py-8 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="text-primary-text inline-block flex-none rtl:rotate-180" />
            <div>
              <span class="text-primary-text">Previous Post</span>
              <div class="text-primary text-sm">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span class="text-primary-text">Next Post</span>
              <div class="text-primary text-sm">{nextPost.title}</div>
            </div>
            <IconChevronRight class="text-primary-text inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>

    <!-- Blogs Comments -->

    <PostComments />
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>

---
import { SITE } from "@/constants";
import getPath from "@/utils/getPath";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";

dayjs.extend(utc);
dayjs.extend(timezone);

const { blog } = Astro.props;
const { author, description, title, pubDate, updatedDate, heroImage } = blog.data;
const isModified = updatedDate && updatedDate > pubDate;
const datetime = dayjs(isModified ? pubDate : pubDate).tz(SITE.timezone);
---

<div>
  <a href={getPath(blog.id, blog.filePath)} class="block p-0">
    <div
      class="flex h-[15rem] min-w-[21rem] cursor-pointer justify-between gap-4 rounded-lg bg-white p-4 shadow-lg transition-transform duration-300 hover:-translate-y-1 dark:bg-[#222a41]"
    >
      <div class="h-auto w-full md:w-[65%]">
        <div class="flex justify-between">
          <p
            class="bg-primary rounded p-1 text-center text-xs font-bold text-sky-800 dark:text-pink-700"
          >
            {updatedDate ? "Updated" : "Published"}
          </p>
          <p class="text-xs">{datetime.format("D MMM, YYYY")}</p>
        </div>
        <div class="items-between flex h-[90%] flex-col justify-between pt-4">
          <div>
            <p class="text-sm font-bold" transition:name={title}>
              {title}
            </p>
            <p class="pt-4 text-sm">{description}</p>
          </div>

          <p class="text-sm font-semibold">{author}</p>
        </div>
      </div>

      <div class="hidden h-full w-[35%] md:block">
        <img
          src={typeof heroImage === "string" ? heroImage : heroImage?.src}
          alt={blog.data.title}
          class="m-0 h-full w-full rounded-lg object-cover"
        />
      </div>
    </div>
  </a>
</div>

---
const pathname = Astro.url.pathname;
const [first, second, third] = pathname.split("/").filter(Boolean);

const routes = {
  blogs: () => (second ? [{ text: `Blogs (page ${second})` }] : [{ text: "Blogs" }]),
  tags: () =>
    third
      ? [{ text: "Tags", href: "/tags" }, { text: `${second} (page ${third})` }]
      : second
        ? [{ text: "Tags", href: "/tags" }, { text: second }]
        : [{ text: "Tags" }],
};

let breadcrumbsList: Array<{ text: string; href?: string }> = routes[
  first as keyof typeof routes
]?.() ?? [{ text: first }];
---

<div class="mt-8">
  <a href="/" class="text-primary-text px-0 underline-offset-4 hover:underline"> Home </a>

  {
    breadcrumbsList.map((item, index) => {
      const isLast = index === breadcrumbsList.length - 1;

      return (
        <>
          <span class="mx-2">/</span>

          {isLast ? (
            <span
              class:list={["text-primary font-bold", { capitalize: breadcrumbsList.length < 2 }]}
            >
              {item.text}
            </span>
          ) : (
            <a
              href={item.href}
              class="text-primary-text capitalize underline-offset-4 hover:underline"
            >
              {item.text}
            </a>
          )}
        </>
      );
    })
  }
</div>

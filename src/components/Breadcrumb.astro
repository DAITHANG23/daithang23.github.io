---
const pathname = Astro.url.pathname;

const breadcrumbs = pathname.split("/").filter(Boolean);

let breadcrumbsList: { text: string; href?: string }[] = [];

if (breadcrumbs[0] === "blogs") {
  breadcrumbsList = [{ text: `Blogs (Page ${breadcrumbs[1]})` }];
} else if (breadcrumbs[0] === "tags") {
  breadcrumbsList = [{ text: "Tags", href: "/tags" }, { text: breadcrumbs[1] }];
}
---

<div class="mt-8">
  <a href="/" class="text-primary-text underline-offset-4 hover:underline"> Home </a>

  {
    breadcrumbsList.map((item, index) => {
      const isLast = index === breadcrumbsList.length - 1;

      return (
        <>
          <span class="mx-2">/</span>

          {isLast ? (
            <span class="text-primary font-bold capitalize">{item.text}</span>
          ) : (
            <a
              href={item.href}
              class="text-primary font-bold capitalize underline-offset-4 hover:underline"
            >
              {item.text}
            </a>
          )}
        </>
      );
    })
  }
</div>
